#!/usr/bin/env bash
#
# Wynko commit-msg hook: require a Conventional Commits subject line, so
# bin/release.sh can compute version bumps and draft changelogs from commit
# history. Activated the same way as the pre-commit hook (core.hooksPath).
#
set -euo pipefail

msg_file="$1"
subject="$(head -n1 "$msg_file")"

# Merge and revert commits carry their own git-generated subject line and are
# exempt — bin/merge-to-main.sh adds the Security-Reviewed trailer, not a
# Conventional Commits type, and reverts aren't part of the changelog draft.
case "$subject" in
	"Merge "* | "Revert \""*)
		exit 0
		;;
esac

pattern='^(feat|fix|docs|refactor|test|chore|ci|build|perf|revert|security)(\([a-z0-9./-]+\))?!?: .+'
if ! [[ "$subject" =~ $pattern ]]; then
	printf 'commit-msg: subject line is not a Conventional Commit: "%s"\n' "$subject" >&2
	printf 'commit-msg: expected "type(scope)?: summary", type one of feat|fix|docs|refactor|test|chore|ci|build|perf|revert|security (append ! for a breaking change)\n' >&2
	exit 1
fi
