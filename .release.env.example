# Copy to .release.env (git-ignored) and fill in your real values, then:
#   source .release.env && bin/release.sh
#
# See CONTRIBUTING.md's "Remotes & release identity" section for how to
# obtain these.

# gpg --list-secret-keys --keyid-format=long | grep sec
export RELEASE_GPG_KEY_ID='REPLACE_WITH_YOUR_GPG_KEY_ID'

# The Host alias for roy-dg in ~/.ssh/config.
export RELEASE_SSH_HOST='github-flexborder'
