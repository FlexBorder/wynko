<?xml version="1.0"?>
<ruleset name="Wynko">
	<description>Coding standards for Wynko (style + best practice).</description>

	<file>wynko.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>config</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress">
		<!-- PSR-4 autoloading names files by class (Client.php), which conflicts
		     with the WordPress class-{name}.php file-naming sniff. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Test doubles and data providers are internal scaffolding: their names and
	     signatures document them, and PHPUnit dictates the shape of the rest. -->
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionCommentThrowTag">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<!-- ApiKey resolves the key from the environment, so its tests must set and
	     unset environment variables. putenv() is the only way to do that, and
	     the warning is aimed at runtime configuration in shipped code. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_putenv">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<!-- tests/bootstrap.php stubs WordPress core functions and hooks (not
	     Wynko's own) so the suite can run outside a WordPress process; their
	     names are WordPress core's to define, not this plugin's to prefix.
	     UninstallTest.php likewise defines WP_UNINSTALL_PLUGIN, a constant
	     WordPress core itself declares unprefixed. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wynko-for-laposta"/>
			</property>
		</properties>
	</rule>
</ruleset>
